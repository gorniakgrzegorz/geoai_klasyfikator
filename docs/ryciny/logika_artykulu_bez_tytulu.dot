lw3 [pos="-260.82,-421.20!", shape=plaintext, style="", width=1.9, height=0.6, label=<<B><FONT POINT-SIZE="13" COLOR="#4a5568">3. Metody</FONT></B>>];
lw4 [pos="-260.82,-561.60!", shape=plaintext, style="", width=1.9, height=0.6, label=<<B><FONT POINT-SIZE="13" COLOR="#4a5568">3. Metody (cd.)</FONT></B>>];
lw5 [pos="-260.82,-702.00!", shape=plaintext, style="", width=1.9, height=0.6, label=<<B><FONT POINT-SIZE="13" COLOR="#4a5568">4. Wyniki</FONT></B>>];
lw6 [pos="-260.82,-842.40!", shape=plaintext, style="", width=1.9, height=0.6, label=<<B><FONT POINT-SIZE="13" COLOR="#4a5568">5. Dyskusja</FONT></B>>];
lw7 [pos="-260.82,-982.80!", shape=plaintext, style="", width=1.9, height=0.6, label=<<B><FONT POINT-SIZE="13" COLOR="#4a5568">6. Wnioski</FONT></B>>];
h0 [pos="0.00,-212.40!", shape=plaintext, style="", width=2.4, height=0.35, label=<<B><FONT POINT-SIZE="12" COLOR="#dd6b20">Wspólna podstawa</FONT></B>>];
h1_35 [pos="335.34,-212.40!", shape=plaintext, style="", width=2.4, height=0.35, label=<<B><FONT POINT-SIZE="12" COLOR="#dd6b20">Tor PB1: cechy</FONT></B>>];
h2_7 [pos="670.68,-212.40!", shape=plaintext, style="", width=2.4, height=0.35, label=<<B><FONT POINT-SIZE="12" COLOR="#dd6b20">Tor PB2: wysokość</FONT></B>>];
h4_05 [pos="1006.02,-212.40!", shape=plaintext, style="", width=2.4, height=0.35, label=<<B><FONT POINT-SIZE="12" COLOR="#dd6b20">Tor PB3: korekty</FONT></B>>];
h5_4 [pos="1341.36,-212.40!", shape=plaintext, style="", width=2.4, height=0.35, label=<<B><FONT POINT-SIZE="12" COLOR="#dd6b20">Tor PB4: powierzchnia</FONT></B>>];
leg0 [pos="-111.78,95.47!", width=3.0, height=0.38, label=<<FONT POINT-SIZE="11">Wprowadzenie: twierdzenie i źródła</FONT>>, fillcolor="#fdf6e3", color="#b7791f"];
leg1 [pos="124.20,95.47!", width=3.0, height=0.38, label=<<FONT POINT-SIZE="11">Pytanie badawcze</FONT>>, fillcolor="#fdf0e3", color="#dd6b20"];
leg2 [pos="360.18,95.47!", width=3.0, height=0.38, label=<<FONT POINT-SIZE="11">Dane i metody</FONT>>, fillcolor="#eef7ea", color="#38a169"];
leg3 [pos="596.16,95.47!", width=3.0, height=0.38, label=<<FONT POINT-SIZE="11">Nowa analiza</FONT>>, fillcolor="#e6fffa", color="#2c7a7b"];
leg4 [pos="832.14,95.47!", width=3.0, height=0.38, label=<<FONT POINT-SIZE="11">Wynik</FONT>>, fillcolor="#e8f1fb", color="#2b6cb0"];
leg5 [pos="1068.12,95.47!", width=3.0, height=0.38, label=<<FONT POINT-SIZE="11">Dyskusja i wnioski</FONT>>, fillcolor="#f1edfa", color="#6b46c1"];
leg6 [pos="1304.10,95.47!", width=3.0, height=0.38, label=<<FONT POINT-SIZE="11">Brak lub ryzyko: blokuje dalszy tekst</FONT>>, fillcolor="#fde8e8", color="#c53030"];
