digraph G {
graph [splines=ortho, outputorder=edgesfirst, bgcolor="white", pad=0.4, fontname="Liberation Sans"];
node [shape=box, style="rounded,filled", fontname="Liberation Sans", margin="0.10,0.06", width=3.05, height=1.42, fixedsize=true, penwidth=1.4];
edge [color="#2d3748", penwidth=1.6, arrowsize=0.8];
w1 [pos="0.00,0.00!", label=<<TABLE BORDER="0" CELLSPACING="0" CELLPADDING="1"><TR><TD><B><FONT POINT-SIZE="12" COLOR="black">1.1 GEOBIA zamiast pikseli</FONT></B></TD></TR><TR><TD><FONT POINT-SIZE="9" COLOR="black">Jednostką analizy jest segment odpowiadający<BR/>fragmentowi terenu, nie piksel.</FONT></TD></TR><TR><TD><FONT POINT-SIZE="8" COLOR="#4a5568"><I>Blaschke 2010</I></FONT></TD></TR></TABLE>>, fillcolor="#fdf6e3", color="#b7791f"];
w2 [pos="422.28,0.00!", label=<<TABLE BORDER="0" CELLSPACING="0" CELLPADDING="1"><TR><TD><B><FONT POINT-SIZE="12" COLOR="black">1.2 Nalot RGB bez podczerwieni</FONT></B></TD></TR><TR><TD><FONT POINT-SIZE="9" COLOR="black">Tanie kamery konsumenckie nie dają NIR, więc<BR/>NDVI jest niedostępny.</FONT></TD></TR><TR><TD><FONT POINT-SIZE="8" COLOR="#4a5568"><I>Woebbecke i in. 1995; Gitelson i in. 2002</I></FONT></TD></TR></TABLE>>, fillcolor="#fdf6e3", color="#b7791f"];
w3 [pos="844.56,0.00!", label=<<TABLE BORDER="0" CELLSPACING="0" CELLPADDING="1"><TR><TD><B><FONT POINT-SIZE="12" COLOR="black">1.3 Powierzchnia z mapy jest<BR/>obciążona</FONT></B></TD></TR><TR><TD><FONT POINT-SIZE="9" COLOR="black">Zliczenie pikseli klasy nie jest estymatorem<BR/>powierzchni tej klasy.</FONT></TD></TR><TR><TD><FONT POINT-SIZE="8" COLOR="#4a5568"><I>Olofsson i in. 2014; Stehman 2014</I></FONT></TD></TR></TABLE>>, fillcolor="#fdf6e3", color="#b7791f"];
w4 [pos="1266.84,0.00!", label=<<TABLE BORDER="0" CELLSPACING="0" CELLPADDING="1"><TR><TD><B><FONT POINT-SIZE="12" COLOR="black">1.4 Narzędzia GEOBIA są zamknięte<BR/>lub trudne</FONT></B></TD></TR><TR><TD><FONT POINT-SIZE="9" COLOR="black">Pełny tor GEOBIA z oceną dokładności rzadko<BR/>bywa dostępny w jednym otwartym narzędziu.</FONT></TD></TR><TR><TD><FONT POINT-SIZE="8" COLOR="#4a5568"><I>[DO UZUPEŁNIENIA: źródło przeglądowe]</I></FONT></TD></TR></TABLE>>, fillcolor="#fdf6e3", color="#b7791f"];
luka [pos="335.34,-140.40!", label=<<TABLE BORDER="0" CELLSPACING="0" CELLPADDING="1"><TR><TD><B><FONT POINT-SIZE="12" COLOR="black">Luka badawcza</FONT></B></TD></TR><TR><TD><FONT POINT-SIZE="9" COLOR="black">Brak otwartego toru łączącego segmentację,<BR/>cechy, las losowy i estymację powierzchni z<BR/>niepewnością w jednym środowisku GIS.</FONT></TD></TR><TR><TD><FONT POINT-SIZE="8" COLOR="#4a5568"><I>wymaga zapisu przeszukania literatury</I></FONT></TD></TR></TABLE>>, fillcolor="#fde8e8", color="#c53030", penwidth=2.8];
cel [pos="1006.02,-140.40!", label=<<TABLE BORDER="0" CELLSPACING="0" CELLPADDING="1"><TR><TD><B><FONT POINT-SIZE="12" COLOR="white">Cel i teza</FONT></B></TD></TR><TR><TD><FONT POINT-SIZE="9" COLOR="white">Teza: tor obiektowy na samym RGB, z<BR/>opcjonalnym NMPT, daje mapę pokrycia wraz z<BR/>powierzchnią i jej niepewnością,<BR/>odtwarzalnie i bez zewnętrznego modelu.</FONT></TD></TR><TR><TD><FONT POINT-SIZE="8" COLOR="#cbd5e0"><I>DECYZJA AUTORA: teza do zatwierdzenia</I></FONT></TD></TR></TABLE>>, fillcolor="#2d3748", color="#2d3748"];
pb1 [pos="335.34,-280.80!", label=<<TABLE BORDER="0" CELLSPACING="0" CELLPADDING="1"><TR><TD><B><FONT POINT-SIZE="12" COLOR="black">PB1 Cechy</FONT></B></TD></TR><TR><TD><FONT POINT-SIZE="9" COLOR="black">Które z 19 cech RGB rozdzielają klasy<BR/>pokrycia i jak mierzyć tę rozdzielność?</FONT></TD></TR></TABLE>>, fillcolor="#fdf0e3", color="#dd6b20"];
pb2 [pos="670.68,-280.80!", label=<<TABLE BORDER="0" CELLSPACING="0" CELLPADDING="1"><TR><TD><B><FONT POINT-SIZE="12" COLOR="black">PB2 Wysokość</FONT></B></TD></TR><TR><TD><FONT POINT-SIZE="9" COLOR="black">Jaki przyrost rozdzielności wnoszą 5 cech z<BR/>NMPT, w tym wysokość nad gruntem?</FONT></TD></TR></TABLE>>, fillcolor="#fdf0e3", color="#dd6b20"];
pb3 [pos="1006.02,-280.80!", label=<<TABLE BORDER="0" CELLSPACING="0" CELLPADDING="1"><TR><TD><B><FONT POINT-SIZE="12" COLOR="black">PB3 Korekty</FONT></B></TD></TR><TR><TD><FONT POINT-SIZE="9" COLOR="black">Czy korekta zieleni i sito poprawiają mapę i<BR/>jak naruszają jej obiektowy charakter?</FONT></TD></TR></TABLE>>, fillcolor="#fdf0e3", color="#dd6b20"];
pb4 [pos="1341.36,-280.80!", label=<<TABLE BORDER="0" CELLSPACING="0" CELLPADDING="1"><TR><TD><B><FONT POINT-SIZE="12" COLOR="black">PB4 Powierzchnia</FONT></B></TD></TR><TR><TD><FONT POINT-SIZE="9" COLOR="black">Jak szeroki jest przedział ufności<BR/>powierzchni klas przy próbie warstwowej?</FONT></TD></TR></TABLE>>, fillcolor="#fdf0e3", color="#dd6b20"];
m31 [pos="0.00,-421.20!", label=<<TABLE BORDER="0" CELLSPACING="0" CELLPADDING="1"><TR><TD><B><FONT POINT-SIZE="12" COLOR="black">3.1 Dane</FONT></B></TD></TR><TR><TD><FONT POINT-SIZE="9" COLOR="black">Ortomozaika RGB z drona, opcjonalnie NMPT z<BR/>tego samego nalotu, ten sam układ i piksel.</FONT></TD></TR><TR><TD><FONT POINT-SIZE="8" COLOR="#4a5568"><I>[DO UZUPEŁNIENIA: obszar, data, rozdzielczość,<BR/>licencja]</I></FONT></TD></TR></TABLE>>, fillcolor="#eef7ea", color="#38a169"];
m32 [pos="0.00,-561.60!", label=<<TABLE BORDER="0" CELLSPACING="0" CELLPADDING="1"><TR><TD><B><FONT POINT-SIZE="12" COLOR="black">3.2 Segmentacja SLIC</FONT></B></TD></TR><TR><TD><FONT POINT-SIZE="9" COLOR="black">Przestrzeń CIELAB, D65, zwartość 0,15, sigma<BR/>2,5, 10 iteracji, liczba segmentów z<BR/>wielkości obiektu.</FONT></TD></TR><TR><TD><FONT POINT-SIZE="8" COLOR="#4a5568"><I>Achanta i in. 2012</I></FONT></TD></TR></TABLE>>, fillcolor="#eef7ea", color="#38a169"];
m33 [pos="335.34,-421.20!", label=<<TABLE BORDER="0" CELLSPACING="0" CELLPADDING="1"><TR><TD><B><FONT POINT-SIZE="12" COLOR="black">3.3 Cechy barwy i faktury</FONT></B></TD></TR><TR><TD><FONT POINT-SIZE="9" COLOR="black">7 wielkości barwy, 3 wskaźniki na<BR/>współrzędnych chromatycznych (ExG, VARI,<BR/>NGRDI), 4 cechy GLCM (15 poziomów, odległość<BR/>1, cztery kierunki), 4 cechy kształtu, 1<BR/>cecha kontekstu.</FONT></TD></TR><TR><TD><FONT POINT-SIZE="8" COLOR="#4a5568"><I>Haralick i in. 1973; obwód estymatorem Croftona</I></FONT></TD></TR></TABLE>>, fillcolor="#eef7ea", color="#38a169"];
m34 [pos="335.34,-561.60!", label=<<TABLE BORDER="0" CELLSPACING="0" CELLPADDING="1"><TR><TD><B><FONT POINT-SIZE="12" COLOR="black">3.4 Las losowy</FONT></B></TD></TR><TR><TD><FONT POINT-SIZE="9" COLOR="black">100 drzew, Gini, pierwiastek z liczby cech,<BR/>bootstrap, ziarno 42, głosowanie miękkie.</FONT></TD></TR><TR><TD><FONT POINT-SIZE="8" COLOR="#4a5568"><I>Breiman 2001</I></FONT></TD></TR></TABLE>>, fillcolor="#eef7ea", color="#38a169"];
m35 [pos="670.68,-421.20!", label=<<TABLE BORDER="0" CELLSPACING="0" CELLPADDING="1"><TR><TD><B><FONT POINT-SIZE="12" COLOR="black">3.5 Cechy z NMPT</FONT></B></TD></TR><TR><TD><FONT POINT-SIZE="9" COLOR="black">Średnia i odchylenie NMPT, nachylenie,<BR/>wysokość względem sąsiedztwa oraz wysokość<BR/>nad gruntem.</FONT></TD></TR></TABLE>>, fillcolor="#eef7ea", color="#38a169"];
m36 [pos="670.68,-561.60!", label=<<TABLE BORDER="0" CELLSPACING="0" CELLPADDING="1"><TR><TD><B><FONT POINT-SIZE="12" COLOR="black">3.6 Grunt z samego NMPT</FONT></B></TD></TR><TR><TD><FONT POINT-SIZE="9" COLOR="black">Minimum w blokach 1 m, otwarcie<BR/>morfologiczne 40 m z ograniczeniem do połowy<BR/>krótszego boku, wygładzenie średnią ruchomą.</FONT></TD></TR><TR><TD><FONT POINT-SIZE="8" COLOR="#4a5568"><I>ograniczenie: duże dachy są zaniżane</I></FONT></TD></TR></TABLE>>, fillcolor="#eef7ea", color="#38a169"];
m37 [pos="1006.02,-421.20!", label=<<TABLE BORDER="0" CELLSPACING="0" CELLPADDING="1"><TR><TD><B><FONT POINT-SIZE="12" COLOR="black">3.7 Korekta zieleni</FONT></B></TD></TR><TR><TD><FONT POINT-SIZE="9" COLOR="black">ExG wygładzony w oknie 3 na 3, próg Youdena<BR/>z 256 kandydatów, segment przypisany w<BR/>całości, gdy udział pikseli przekroczy 0,25.</FONT></TD></TR></TABLE>>, fillcolor="#eef7ea", color="#38a169"];
m38 [pos="1006.02,-561.60!", label=<<TABLE BORDER="0" CELLSPACING="0" CELLPADDING="1"><TR><TD><B><FONT POINT-SIZE="12" COLOR="black">3.8 Sito</FONT></B></TD></TR><TR><TD><FONT POINT-SIZE="9" COLOR="black">Usuwanie łat mniejszych od progu w<BR/>sąsiedztwie czterospójnym, bez wygładzania<BR/>granic.</FONT></TD></TR></TABLE>>, fillcolor="#eef7ea", color="#38a169"];
m39 [pos="1341.36,-421.20!", label=<<TABLE BORDER="0" CELLSPACING="0" CELLPADDING="1"><TR><TD><B><FONT POINT-SIZE="12" COLOR="black">3.9 Próba warstwowa</FONT></B></TD></TR><TR><TD><FONT POINT-SIZE="9" COLOR="black">Warstwy to klasy mapy, punkty losowane w<BR/>obrębie warstwy, warstwa zapisana razem z<BR/>punktem.</FONT></TD></TR><TR><TD><FONT POINT-SIZE="8" COLOR="#4a5568"><I>Stehman 2014</I></FONT></TD></TR></TABLE>>, fillcolor="#eef7ea", color="#38a169"];
m40 [pos="1341.36,-561.60!", label=<<TABLE BORDER="0" CELLSPACING="0" CELLPADDING="1"><TR><TD><B><FONT POINT-SIZE="12" COLOR="black">3.10 Estymatory Olofssona</FONT></B></TD></TR><TR><TD><FONT POINT-SIZE="9" COLOR="black">Udziały p_ij ważone powierzchnią warstw,<BR/>wariancje z równań 5 do 7, przedział 95<BR/>procent z z = 1,96.</FONT></TD></TR><TR><TD><FONT POINT-SIZE="8" COLOR="#4a5568"><I>Olofsson i in. 2014, równania 5 do 7</I></FONT></TD></TR></TABLE>>, fillcolor="#eef7ea", color="#38a169"];
blok [pos="0.00,-702.00!", label=<<TABLE BORDER="0" CELLSPACING="0" CELLPADDING="1"><TR><TD><B><FONT POINT-SIZE="12" COLOR="black">Warunek: zbiór referencyjny</FONT></B></TD></TR><TR><TD><FONT POINT-SIZE="9" COLOR="black">Bez niezależnego zbioru referencyjnego z<BR/>realnego nalotu żaden wynik liczbowy nie<BR/>może wejść do artykułu.</FONT></TD></TR><TR><TD><FONT POINT-SIZE="8" COLOR="#4a5568"><I>STAN: brak, analizy na danych rzeczywistych nie<BR/>wykonano</I></FONT></TD></TR></TABLE>>, fillcolor="#fde8e8", color="#c53030", penwidth=2.8];
r1 [pos="335.34,-702.00!", label=<<TABLE BORDER="0" CELLSPACING="0" CELLPADDING="1"><TR><TD><B><FONT POINT-SIZE="12" COLOR="black">4.1 Rozdzielność klas (PB1)</FONT></B></TD></TR><TR><TD><FONT POINT-SIZE="9" COLOR="black">Macierz JM par klas z walidacji krzyżowej,<BR/>progi 1,9 i 1,7; ranking ważności cech.</FONT></TD></TR><TR><TD><FONT POINT-SIZE="8" COLOR="#4a5568"><I>[DO UZUPEŁNIENIA: liczby po biegu na danych]</I></FONT></TD></TR></TABLE>>, fillcolor="#e8f1fb", color="#2b6cb0"];
r2 [pos="670.68,-702.00!", label=<<TABLE BORDER="0" CELLSPACING="0" CELLPADDING="1"><TR><TD><B><FONT POINT-SIZE="12" COLOR="black">4.2 Wkład wysokości (PB2)</FONT></B></TD></TR><TR><TD><FONT POINT-SIZE="9" COLOR="black">Dokładność i JM dla 19 cech kontra 24 cechy,<BR/>ta sama próba i to samo ziarno.</FONT></TD></TR><TR><TD><FONT POINT-SIZE="8" COLOR="#4a5568"><I>[DO UZUPEŁNIENIA: liczby po biegu na danych]</I></FONT></TD></TR></TABLE>>, fillcolor="#e8f1fb", color="#2b6cb0"];
r3 [pos="1006.02,-702.00!", label=<<TABLE BORDER="0" CELLSPACING="0" CELLPADDING="1"><TR><TD><B><FONT POINT-SIZE="12" COLOR="black">4.3 Skutek korekt (PB3)</FONT></B></TD></TR><TR><TD><FONT POINT-SIZE="9" COLOR="black">Dokładność przed i po korekcie zieleni oraz<BR/>po sicie, liczba i powierzchnia zmienionych<BR/>segmentów.</FONT></TD></TR><TR><TD><FONT POINT-SIZE="8" COLOR="#4a5568"><I>[DO UZUPEŁNIENIA: liczby po biegu na danych]</I></FONT></TD></TR></TABLE>>, fillcolor="#e8f1fb", color="#2b6cb0"];
r4 [pos="1341.36,-702.00!", label=<<TABLE BORDER="0" CELLSPACING="0" CELLPADDING="1"><TR><TD><B><FONT POINT-SIZE="12" COLOR="black">4.4 Powierzchnia z niepewnością<BR/>(PB4)</FONT></B></TD></TR><TR><TD><FONT POINT-SIZE="9" COLOR="black">Powierzchnie klas skorygowane o błąd<BR/>klasyfikacji z przedziałami 95 procent, obok<BR/>powierzchni zliczonej z mapy.</FONT></TD></TR><TR><TD><FONT POINT-SIZE="8" COLOR="#4a5568"><I>kod sprawdzony na tab. 8 z Olofsson i in. 2014:<BR/>0,9449</I></FONT></TD></TR></TABLE>>, fillcolor="#e8f1fb", color="#2b6cb0"];
d1 [pos="335.34,-842.40!", label=<<TABLE BORDER="0" CELLSPACING="0" CELLPADDING="1"><TR><TD><B><FONT POINT-SIZE="12" COLOR="black">5.1 Czego RGB nie rozdziela</FONT></B></TD></TR><TR><TD><FONT POINT-SIZE="9" COLOR="black">Klasy różniące się układem przestrzennym, a<BR/>nie materiałem, pozostają nierozdzielone, bo<BR/>brak cech wyglądu z sieci transformerowej.</FONT></TD></TR><TR><TD><FONT POINT-SIZE="8" COLOR="#4a5568"><I>ograniczenie wpisane w metodę</I></FONT></TD></TR></TABLE>>, fillcolor="#f1edfa", color="#6b46c1"];
d2 [pos="670.68,-842.40!", label=<<TABLE BORDER="0" CELLSPACING="0" CELLPADDING="1"><TR><TD><B><FONT POINT-SIZE="12" COLOR="black">5.2 Granice estymacji gruntu</FONT></B></TD></TR><TR><TD><FONT POINT-SIZE="9" COLOR="black">Otwarcie 40 m zaniża wysokość budynków<BR/>szerszych od okna; wariant z osobnym NMT<BR/>usuwa to ograniczenie.</FONT></TD></TR></TABLE>>, fillcolor="#f1edfa", color="#6b46c1"];
d3 [pos="1006.02,-842.40!", label=<<TABLE BORDER="0" CELLSPACING="0" CELLPADDING="1"><TR><TD><B><FONT POINT-SIZE="12" COLOR="black">5.3 Cena korekt pikselowych</FONT></B></TD></TR><TR><TD><FONT POINT-SIZE="9" COLOR="black">Korekta zieleni i sito są operacjami<BR/>pikselowymi w torze obiektowym, co trzeba<BR/>podać wprost przy opisie mapy.</FONT></TD></TR></TABLE>>, fillcolor="#f1edfa", color="#6b46c1"];
d4 [pos="1341.36,-842.40!", label=<<TABLE BORDER="0" CELLSPACING="0" CELLPADDING="1"><TR><TD><B><FONT POINT-SIZE="12" COLOR="black">5.4 Powierzchnia kontra piksele</FONT></B></TD></TR><TR><TD><FONT POINT-SIZE="9" COLOR="black">Różnica między powierzchnią z mapy a<BR/>estymatorem ważonym pokazuje, dlaczego sama<BR/>mapa nie wystarcza.</FONT></TD></TR><TR><TD><FONT POINT-SIZE="8" COLOR="#4a5568"><I>Olofsson i in. 2014</I></FONT></TD></TR></TABLE>>, fillcolor="#f1edfa", color="#6b46c1"];
wn [pos="422.28,-982.80!", label=<<TABLE BORDER="0" CELLSPACING="0" CELLPADDING="1"><TR><TD><B><FONT POINT-SIZE="12" COLOR="black">6. Wnioski</FONT></B></TD></TR><TR><TD><FONT POINT-SIZE="9" COLOR="black">Odpowiedzi na PB1 do PB4, bez nowych liczb,<BR/>z zasięgiem ograniczonym do badanego obszaru<BR/>i rozdzielczości.</FONT></TD></TR></TABLE>>, fillcolor="#f1edfa", color="#6b46c1"];
st [pos="1006.02,-982.80!", label=<<TABLE BORDER="0" CELLSPACING="0" CELLPADDING="1"><TR><TD><B><FONT POINT-SIZE="12" COLOR="white">Streszczenie i Highlights</FONT></B></TD></TR><TR><TD><FONT POINT-SIZE="9" COLOR="white">Liczby wyłącznie z rozdziału 4; dopóki<BR/>rozdział 4 jest pusty, streszczenie nie<BR/>zawiera wartości.</FONT></TD></TR></TABLE>>, fillcolor="#2d3748", color="#2d3748"];
kod [pos="1341.36,-982.80!", label=<<TABLE BORDER="0" CELLSPACING="0" CELLPADDING="1"><TR><TD><B><FONT POINT-SIZE="12" COLOR="black">Dostępność kodu i danych</FONT></B></TD></TR><TR><TD><FONT POINT-SIZE="9" COLOR="black">Repozytorium geoai_klasyfikator z tagiem<BR/>wersji, DOI z Zenodo, spis wersji bibliotek.</FONT></TD></TR><TR><TD><FONT POINT-SIZE="8" COLOR="#4a5568"><I>[DO UZUPEŁNIENIA: DOI Zenodo]</I></FONT></TD></TR></TABLE>>, fillcolor="#eef7ea", color="#38a169"];
lw0 [pos="-260.82,0.00!", shape=plaintext, style="", width=1.9, height=0.6, label=<<B><FONT POINT-SIZE="13" COLOR="#4a5568">1. Wprowadzenie</FONT></B>>];
lw1 [pos="-260.82,-140.40!", shape=plaintext, style="", width=1.9, height=0.6, label=<<B><FONT POINT-SIZE="13" COLOR="#4a5568">Luka i cel</FONT></B>>];
